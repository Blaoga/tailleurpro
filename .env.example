# ==============================================================================
# TAILLEUR PRO - MODÈLE DE CONFIGURATION (.env.example)
# ==============================================================================
# Instructions :
# 1. Copiez ce fichier et renommez-le "env.local" (ou ".env.local")
# 2. Remplissez les valeurs avec vos propres identifiants Supabase
# 3. Ne commitez JAMAIS votre fichier env.local sur Git !

# 1. Configuration Supabase
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_publique_ici

# 2. Support et Paramètres Métier
WHATSAPP_SUPPORT=237600000000
APP_NAME=Tailleur Pro
APP_VERSION=1.0.0
DUREE_ESSAI_JOURS=15
PRIX_ESSAI_FCFA=0
PRIX_SOLO_FCFA=2600
PRIX_ATELIER_FCFA=5100
PRIX_MENSUEL_FCFA=2600
